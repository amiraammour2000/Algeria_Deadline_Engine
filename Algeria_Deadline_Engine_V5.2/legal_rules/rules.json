{
  "ruleset_id": "DZ-ADMIN-PROCEDURAL",
  "ruleset_version": "2.1.0-v3.1",
  "status": "prototype_juridique_a_valider",
  "normative_sources": [
    {
      "id": "LAW-08-09",
      "title": "Loi n°08-09 du 25 février 2008 portant Code de procédure civile et administrative",
      "official_journal": "JO n°21 du 23 avril 2008",
      "status": "source_officielle"
    },
    {
      "id": "LAW-22-13",
      "title": "Loi n°22-13 du 12 juillet 2022 modifiant et complétant la loi n°08-09",
      "official_journal": "JO n°48 du 17 juillet 2022",
      "status": "source_officielle"
    }
  ],
  "rules": [
    {
      "id": "ALG-08-09-829",
      "article": "829",
      "type": "contentieux",
      "title": "Délai de recours devant le tribunal administratif",
      "duration": {
        "value": 4,
        "unit": "months"
      },
      "trigger": "notification_individual_or_publication_collective_or_regulatory",
      "requires_human_validation": true,
      "computation_mode": "calendar",
      "endpoint_policy": "none"
    },
    {
      "id": "ALG-08-09-830-R",
      "article": "830",
      "type": "reclamation",
      "title": "Réclamation administrative pendant le délai de recours",
      "duration": {
        "value": 4,
        "unit": "months"
      },
      "trigger": "within_article_829_period",
      "requires_human_validation": true,
      "computation_mode": "calendar",
      "endpoint_policy": "none"
    },
    {
      "id": "ALG-08-09-830-S",
      "article": "830",
      "type": "silence_reclamation",
      "title": "Silence administratif sur réclamation",
      "duration": {
        "value": 2,
        "unit": "months"
      },
      "trigger": "notification_reclamation_to_authority",
      "effect": "implicit_rejection",
      "requires_human_validation": true,
      "computation_mode": "calendar",
      "endpoint_policy": "none"
    },
    {
      "id": "ALG-08-09-830-C",
      "article": "830",
      "type": "contentieux_after_reclamation",
      "title": "Recours contentieux après silence sur réclamation",
      "duration": {
        "value": 2,
        "unit": "months"
      },
      "trigger": "expiry_of_two_month_reclamation_period",
      "requires_human_validation": true,
      "computation_mode": "calendar",
      "endpoint_policy": "none"
    },
    {
      "id": "ALG-08-09-830-RR",
      "article": "830",
      "type": "contentieux_after_reply",
      "title": "Recours contentieux après réponse à la réclamation",
      "duration": {
        "value": 2,
        "unit": "months"
      },
      "trigger": "notification_of_rejection",
      "requires_human_validation": true,
      "computation_mode": "calendar",
      "endpoint_policy": "none"
    },
    {
      "id": "ALG-08-09-831",
      "article": "831",
      "type": "opposability",
      "title": "Opposabilité du délai mentionné dans la notification",
      "trigger": "notification",
      "requires_human_validation": true
    },
    {
      "id": "ALG-08-09-832",
      "article": "832",
      "type": "interruption",
      "title": "Causes d'interruption des délais",
      "events": [
        "incompetent_administrative_court",
        "legal_aid_request",
        "death_or_change_of_capacity",
        "force_majeure_or_accident"
      ],
      "requires_human_validation": true
    }
  ]
}